{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "objective",
    "workdir",
    "mode",
    "acceptance_criteria"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "workdir": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "review",
        "implement"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "allowed_files": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "context": {
      "type": "string",
      "maxLength": 32000
    },
    "model": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{1,100}$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "board_thread": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,100}$"
    }
  }
}
